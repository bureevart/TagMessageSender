<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
        <PackageReference Include="Google.Protobuf"  Version="3.25.3" />
        <!-- Grpc.Tools нужен только на этапе сборки, поэтому PrivateAssets="All" -->
        <PackageReference Include="Grpc.Tools"       Version="2.61.0" PrivateAssets="All" />
    </ItemGroup>

    <!-- генерируем типы из вашего proto -->
    <ItemGroup>
        <Protobuf Include="Protos/tag_value_updated.proto" GrpcServices="None" />
    </ItemGroup>
    <ItemGroup>
      <None Update="appsettings.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="data.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
